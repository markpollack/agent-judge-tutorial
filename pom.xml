<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.markpollack</groupId>
    <artifactId>agent-judge-tutorial</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Agent Judge Tutorial</name>
    <description>Progressive tutorial modules for learning Agent Judge evaluation</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <agent-judge.version>0.16.0-SNAPSHOT</agent-judge.version>
        <agent-client.version>0.29.3</agent-client.version>
        <koog.version>1.1.1</koog.version>
        <langchain4j.version>1.19.0</langchain4j.version>
        <mockito.version>5.7.0</mockito.version>
        <junit.version>5.13.4</junit.version>
        <opentest4j.version>1.3.0</opentest4j.version>
        <surefire.version>3.5.6</surefire.version>
        <slf4j.version>2.0.16</slf4j.version>
    </properties>

    <modules>
        <!-- The oracle arc: each module is introduced by the evaluation problem it creates,
             not by the next Agent Judge API. -->

        <!-- PetClinic evidence arc: the agent changed a real project -->
        <module>module-01-build-judge</module>
        <module>module-02-coverage-evidence</module>
        <module>module-03-ai-architecture-judge</module>
        <module>module-04-agentic-architecture-judge</module>
        <module>module-05-definition-of-done</module>
        <module>module-06-spec-conformance</module>
        <module>module-07-architecture-rules</module>

        <!-- The JUnit bridge the modules assert through -->
        <module>judge-junit</module>

        <!-- Known and judgment oracles: where JUnit stops and Agent Judge starts -->
        <module>module-01-oracle-boundary</module>
        <module>module-02-build-and-tests</module>
        <module>module-03-coverage-evidence</module>

        <!-- Writing judges: from a lambda to a reusable derived-oracle judge -->
        <module>module-04-custom-judge</module>
        <module>module-05-derived-judge</module>

        <!-- Composing an explicit definition of done -->
        <module>module-06-definition-of-done</module>

        <!-- Judgment oracles, aggregation, and failure semantics -->
        <module>module-07-model-backed-judge</module>
        <module>module-08-jury</module>
        <module>module-09-error-and-escalation</module>

        <!-- Evaluating real agent frameworks against the same bar -->
        <module>module-10-koog-evaluation</module>
        <module>module-11-langchain4j-evaluation</module>
    </modules>

    <!--
      Agent Judge is developed alongside this tutorial and the tutorial tracks its
      latest snapshot on purpose: when a module has to hand-roll something the
      library cannot express, that is a library gap with evidence attached, and the
      fix arrives here as soon as it lands.
    -->
    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>agent-judge-core</artifactId>
                <version>${agent-judge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>agent-judge-exec</artifactId>
                <version>${agent-judge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>agent-judge-file</artifactId>
                <version>${agent-judge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>agent-judge-ai-core</artifactId>
                <version>${agent-judge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>agent-judge-llm</artifactId>
                <version>${agent-judge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>agent-judge-agent-client</artifactId>
                <version>${agent-judge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>agent-judge-koog</artifactId>
                <version>${agent-judge.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>agent-judge-langchain4j</artifactId>
                <version>${agent-judge.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.koog</groupId>
                <artifactId>koog-agents-jvm</artifactId>
                <version>${koog.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.markpollack</groupId>
                <artifactId>judge-junit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.opentest4j</groupId>
                <artifactId>opentest4j</artifactId>
                <version>${opentest4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!--
                          Tests resolve test-workspace the same way exec:java does:
                          relative to the directory Maven was launched from. Run the
                          tutorial from the repository root.
                        -->
                        <workingDirectory>${session.executionRootDirectory}</workingDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.1.0</version>
                    <configuration>
                        <cleanupDaemonThreads>false</cleanupDaemonThreads>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
