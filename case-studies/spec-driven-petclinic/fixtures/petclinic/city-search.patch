+	@GetMapping("/owners/by-city")
+	public String processFindByCityForm(@RequestParam(defaultValue = "1") int page, Owner owner, BindingResult result,
+			Model model) {
+		// allow parameterless GET request for /owners/by-city to return all records
+		String city = owner.getCity();
+		if (city == null) {
+			city = ""; // empty string signifies broadest possible search
+		}
+		else {
+			city = city.strip();
+		}
+
+		// find owners by city
+		Page<Owner> ownersResults = findPaginatedForOwnersCity(page, city);
+		if (ownersResults.isEmpty()) {
+			// no owners found
+			result.rejectValue("city", "notFound", "not found");
+			return "owners/findOwners";
+		}
+
+		if (ownersResults.getTotalElements() == 1) {
+			// 1 owner found
+			owner = ownersResults.iterator().next();
+			return "redirect:/owners/" + owner.getId();
+		}
+
+		// multiple owners found
+		return addPaginationModel(page, model, ownersResults);
+	}
+
